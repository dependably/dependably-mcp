{
  "name": "dependably-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Dependably artifact repository, self-hosted or SaaS (npm/PyPI/NuGet/Maven/RPM/OCI/Go/Cargo).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dependably",
    "artifact-repository",
    "supply-chain",
    "registry"
  ],
  "author": "Michael Hiland",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dependably/dependably-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dependably/dependably-mcp/issues"
  },
  "homepage": "https://github.com/dependably/dependably-mcp#readme",
  "type": "module",
  "bin": {
    "dependably-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "npm run test:unit && node scripts/smoke.mjs && node scripts/sync-manifest.mjs --check",
    "prepublishOnly": "npm test",
    "prepare": "husky",
    "sbom": "node scripts/sbom.mjs",
    "manifest:sync": "node scripts/sync-manifest.mjs",
    "bundle": "node scripts/bundle.mjs",
    "bundle:verify": "node scripts/bundle.mjs --verify",
    "pretest:unit": "mkdir -p coverage",
    "test:unit": "node --test --experimental-test-coverage --enable-source-maps --test-coverage-exclude='test/**' --test-coverage-exclude='scripts/**' --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout --test-coverage-lines=90 --test-coverage-branches=85 test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@cyclonedx/cyclonedx-npm": "5.0.0",
    "@dependably/npm-check": "1.8.0",
    "@types/node": "22.20.0",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "MIT"
}
