{
  "name": "dependably-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Dependably self-hosted artifact repository (npm/PyPI/NuGet/Maven/RPM/OCI/Go/Cargo).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dependably",
    "artifact-repository",
    "supply-chain",
    "registry"
  ],
  "author": "Michael Hiland",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.northwardlabs.ca/moonlitlabs/dependably-mcp.git"
  },
  "type": "module",
  "bin": {
    "dependably-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "pretest": "npm run build",
    "test": "node scripts/smoke.mjs",
    "prepublishOnly": "npm test",
    "prepare": "husky",
    "sbom": "cyclonedx-npm --output-format json --output-file sbom.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "5.0.0",
    "@dependably/npm-check": "1.8.0",
    "@types/node": "22.20.0",
    "husky": "9.1.7",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
